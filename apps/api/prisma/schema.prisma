// Esquema de base de datos de ParqueaVecino.
// Los enums deben coincidir con @parqueavecino/contracts (hay una prueba que lo verifica).
// La tabla de reseñas se agrega en su fase (ver docs/PLAN.md).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DRIVER
  PARTNER
  ADMIN
}

enum VehicleType {
  CAR
  MOTORCYCLE
  BICYCLE
}

enum Shift {
  DAY
  NIGHT
  FULL
}

enum Amenity {
  ROOF
  SECURITY_24H
  CAMERAS
  BIKE_SPOT
  EV_CHARGER
}

enum BookingStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Estado de la cuenta conectada del aliado (Stripe Connect) para recibir transferencias.
enum PayoutAccountStatus {
  PENDING
  ACTION_REQUIRED
  ACTIVE
}

enum DocumentType {
  LIABILITY_POLICY
  RUT
  E_INVOICING
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum ParkingLotStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  PAUSED
  SUSPENDED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         UserRole
  /// false = cuenta suspendida por el admin: no puede ingresar.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  vehicles      Vehicle[]
  parkingLots   ParkingLot[]
  bookings      Booking[]
  payoutAccount PayoutAccount?

  @@index([role])

  @@map("users")
}

/// Sesiones: se guarda solo el hash del refresh token; se rota en cada uso.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Vehicle {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  plate     String
  type      VehicleType
  nickname  String?
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, plate])
  @@map("vehicles")
}

model ParkingLot {
  id           String           @id @default(uuid()) @db.Uuid
  partnerId    String           @map("partner_id") @db.Uuid
  name         String
  address      String
  neighborhood String?
  city         String
  latitude     Float
  longitude    Float
  description  String?
  amenities    Amenity[]        @default([])
  /// URLs de las fotos (hoy ilustraciones demo servidas por la web; luego S3).
  photos       String[]         @default([])
  status       ParkingLotStatus @default(DRAFT)
  verifiedAt   DateTime?        @map("verified_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  partner  User      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  offers    Offer[]
  bookings  Booking[]
  documents ParkingLotDocument[]

  @@index([partnerId])
  @@index([status])
  @@map("parking_lots")
}

/// Cupos mensuales que el aliado publica por franja y tipo de vehículo.
model Offer {
  id                String      @id @default(uuid()) @db.Uuid
  parkingLotId      String      @map("parking_lot_id") @db.Uuid
  shift             Shift
  vehicleType       VehicleType @map("vehicle_type")
  totalSpots        Int         @map("total_spots")
  availableSpots    Int         @map("available_spots")
  monthlyPriceMinor Int         @map("monthly_price_minor")
  currency          String      @db.Char(3)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  parkingLot ParkingLot @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@unique([parkingLotId, shift, vehicleType])
  @@map("offers")
}

/// Documento de verificación de un parqueadero (póliza RC, RUT...). Uno vigente por tipo:
/// subir otro lo reemplaza y vuelve a revisión. El archivo vive en S3 (solo se guarda la llave).
model ParkingLotDocument {
  id                 String         @id @default(uuid()) @db.Uuid
  parkingLotId       String         @map("parking_lot_id") @db.Uuid
  type               DocumentType
  status             DocumentStatus @default(PENDING_REVIEW)
  fileKey            String         @map("file_key")
  fileName           String         @map("file_name")
  contentType        String         @map("content_type")
  sizeBytes          Int            @map("size_bytes")
  /// Último día de vigencia (fecha en APP_TIMEZONE); null si el documento no vence.
  expiresAt          DateTime?      @map("expires_at") @db.Date
  rejectionReason    String?        @map("rejection_reason")
  reviewedAt         DateTime?      @map("reviewed_at")
  /// Cuándo se avisó al aliado que el documento está por vencer (una sola vez por archivo).
  expiryNoticeSentAt DateTime?      @map("expiry_notice_sent_at")
  uploadedAt         DateTime       @default(now()) @map("uploaded_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  parkingLot ParkingLot @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)

  @@unique([parkingLotId, type])
  @@index([status])
  @@index([expiresAt])
  @@map("parking_lot_documents")
}

/// Parámetros de negocio editables (comisión, franjas, topes...). Ver settingsSchemas en contracts.
model SystemSetting {
  key         String   @id
  value       Json
  description String
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Mensualidad comprada por un conductor. Precio y franja se copian del cupo al reservar.
model Booking {
  id           String        @id @default(uuid()) @db.Uuid
  driverId     String        @map("driver_id") @db.Uuid
  parkingLotId String        @map("parking_lot_id") @db.Uuid
  offerId      String        @map("offer_id") @db.Uuid
  shift        Shift
  vehicleType  VehicleType   @map("vehicle_type")
  plate        String
  priceMinor   Int           @map("price_minor")
  currency     String        @db.Char(3)
  status       BookingStatus @default(PENDING_PAYMENT)
  accessCode   String?       @unique @map("access_code")
  startsAt     DateTime?     @map("starts_at")
  endsAt       DateTime?     @map("ends_at")
  /// Renovación: mensualidad que continúa esta (empieza cuando la anterior termina).
  renewalOfId  String?       @map("renewal_of_id") @db.Uuid
  /// Cuándo se avisó al conductor que la mensualidad está por terminar (una sola vez).
  expiryNoticeSentAt DateTime? @map("expiry_notice_sent_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  renewalOf  Booking?   @relation("BookingRenewal", fields: [renewalOfId], references: [id], onDelete: SetNull)
  renewals   Booking[]  @relation("BookingRenewal")
  driver     User       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  parkingLot ParkingLot @relation(fields: [parkingLotId], references: [id], onDelete: Restrict)
  offer      Offer      @relation(fields: [offerId], references: [id], onDelete: Restrict)
  payments   Payment[]

  @@index([driverId])
  @@index([parkingLotId])
  @@index([status])
  @@index([renewalOfId])
  @@map("bookings")
}

/// Cobro de una mensualidad (libro de movimientos). Comisión calculada con commission.basisPoints.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  provider        String
  /// Id del cobro en la pasarela (PaymentIntent de Stripe).
  providerRef     String        @unique @map("provider_ref")
  amountMinor     Int           @map("amount_minor")
  commissionMinor Int           @map("commission_minor")
  currency        String        @db.Char(3)
  status          PaymentStatus @default(PENDING)
  /// Cuenta conectada que recibe el pago menos la comisión (null = cobro de la plataforma).
  destinationRef  String?       @map("destination_ref")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("payments")
}

/// Cuenta conectada del aliado en la pasarela (Stripe Connect): recibe sus pagos menos la comisión.
model PayoutAccount {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @unique @map("user_id") @db.Uuid
  provider    String
  /// Id de la cuenta en la pasarela (acct_... en Stripe).
  providerRef String              @unique @map("provider_ref")
  status      PayoutAccountStatus @default(PENDING)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

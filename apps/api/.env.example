# ---------- App ----------
NODE_ENV=development
API_PORT=3001
API_PREFIX=api
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
APP_TIMEZONE=America/Bogota
APP_LOCALE=es-CO
APP_CURRENCY=COP

# ---------- Base de datos (docker/docker-compose.yml) ----------
DATABASE_URL=postgresql://parqueavecino:parqueavecino@localhost:5432/parqueavecino?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Almacenamiento S3 (S3Mock en local; en AWS se omiten endpoint y llaves) ----------
S3_REGION=us-east-2
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET_UPLOADS=parqueavecino-uploads
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local

# ---------- Correo (Mailpit en local) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=ParqueaVecino <no-reply@parqueavecino.local>

# ---------- Auth (valores solo para desarrollo local) ----------
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
JWT_REFRESH_TTL=7d

# ---------- Stripe (modo test: https://dashboard.stripe.com/test/apikeys) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

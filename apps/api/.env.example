# ---------- App ----------
NODE_ENV=development
API_PORT=3001
API_PREFIX=api
LOG_LEVEL=debug
# CORS solo si otra web (otro origen) consume la API; la web propia usa el proxy /api.
# CORS_ORIGINS=http://otro-dominio.com
SWAGGER_ENABLED=true
APP_TIMEZONE=America/Bogota
APP_LOCALE=es-CO
APP_CURRENCY=COP
SETTINGS_CACHE_TTL_SECONDS=60

# ---------- Base de datos (docker/docker-compose.yml) ----------
# Base de pruebas e2e: se crea y migra sola al correr `pnpm test:e2e`.
# SSL hacia la BD: disable en local; en AWS verify-full con el certificado de RDS.
DATABASE_SSL=disable
TEST_DATABASE_URL=postgresql://parqueavecino:parqueavecino@localhost:5433/parqueavecino_test?schema=public
DATABASE_URL=postgresql://parqueavecino:parqueavecino@localhost:5433/parqueavecino?schema=public

# ---------- Seed (prisma/seed.ts) ----------
SEED_ADMIN_EMAIL=admin@parqueavecino.local
SEED_ADMIN_PASSWORD=dev-only-Admin1234
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=dev-only-Demo1234

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Almacenamiento S3 (S3Mock en local; en AWS se omiten endpoint y llaves) ----------
S3_REGION=us-east-2
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET_UPLOADS=parqueavecino-uploads
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local

# ---------- Correo (Mailpit en local) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=ParqueaVecino <no-reply@parqueavecino.local>

# ---------- Auth (valores solo para desarrollo local) ----------
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# En local se sirve por http; en AWS (CloudFront/HTTPS) va en true.
COOKIE_SECURE=false

# ---------- Stripe (modo test: https://dashboard.stripe.com/test/apikeys) ----------
# Llave secreta de prueba (sk_test_...). Nunca subirla al repo: va solo en tu .env.
STRIPE_SECRET_KEY=
# whsec_... que imprime `stripe listen --forward-to localhost:3001/api/payments/webhooks/stripe`.
# Sin webhook la reserva igual se confirma al volver del pago (la API consulta el PaymentIntent).
STRIPE_WEBHOOK_SECRET=
# Stripe Connect: país de las cuentas de los aliados (Colombia no está en Connect; en test, US).
STRIPE_CONNECT_COUNTRY=US
# URL pública de la web: el aliado vuelve aquí al terminar de conectar sus pagos.
WEB_URL=http://localhost:3000
# Barrido de reservas sin pagar / vencidas, en segundos (0 lo desactiva).
BOOKINGS_SWEEP_INTERVAL_SECONDS=60

# Límite de intentos de login/registro/refresh por IP (protege contra fuerza bruta).
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
# Proxies delante de la API para leer la IP real del cliente (local 0; en AWS, Caddy = 1).
TRUST_PROXY_HOPS=0

# Geocodificador: Nominatim (OpenStreetMap), gratis y sin llave. Política: User-Agent propio y caché.
GEOCODER_URL=https://nominatim.openstreetmap.org/
GEOCODER_USER_AGENT=ParqueaVecino/0.1 (proyecto academico)
GEOCODER_COUNTRY_CODES=co
GEOCODER_BIAS_DEGREES=0.3
GEOCODER_CACHE_TTL_SECONDS=86400
GEOCODER_TIMEOUT_MS=5000

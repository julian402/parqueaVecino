# La web llama a la API en su mismo origen. No cambiar salvo que la API viva en otro dominio.
NEXT_PUBLIC_API_URL=/api
# Solo local: a dónde reenvía Next las llamadas /api (apps/api). En AWS no se usa.
API_PROXY_URL=http://localhost:3001
NEXT_PUBLIC_APP_LOCALE=es-CO
NEXT_PUBLIC_APP_TIMEZONE=America/Bogota
NEXT_PUBLIC_APP_CURRENCY=COP
# Mapa: OpenFreeMap (gratis, sin llave). Cambiar aquí si se usa otro proveedor.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
